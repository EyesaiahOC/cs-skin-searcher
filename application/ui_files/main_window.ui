                 </item>
                </layout>
               </widget>
              </item>
              <item>
               <widget class="QWidget" name="tagger_tags_panel">
                <property name="sizePolicy">
                 <sizepolicy hsizetype="Preferred" vsizetype="Expanding">
                  <horstretch>3</horstretch>
                  <verstretch>0</verstretch>
                 </sizepolicy>
                </property>
                <layout class="QVBoxLayout" name="taggerTagsLayout">
                 <property name="spacing">
                  <number>4</number>
                 </property>
                 <property name="leftMargin">
                  <number>0</number>
                 </property>
                 <property name="topMargin">
                  <number>0</number>
                 </property>
                 <property name="rightMargin">
                  <number>0</number>
                 </property>
                 <property name="bottomMargin">
                  <number>0</number>
                 </property>
                 <item>
                  <widget class="QLabel" name="tagger_tags_heading">
                   <property name="text">
                    <string>Tags</string>
                   </property>
                   <property name="font">
                    <font>
                     <weight>75</weight>
                     <bold>true</bold>
                    </font>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
             </layout>
            </item>

            <!-- Navigation buttons -->
            <item>
             <layout class="QHBoxLayout" name="taggerNavLayout">
              <property name="spacing">
               <number>8</number>
              </property>
              <item>
               <widget class="QPushButton" name="tagger_prev_btn">
                <property name="text">
                 <string>← Previous  Ctrl+←</string>
                </property>
               </widget>
              </item>
              <item>
               <spacer name="taggerNavSpacer">
                <property name="orientation">
                 <enum>Qt::Horizontal</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>40</width>
                  <height>20</height>
                 </size>
                </property>
               </spacer>
              </item>
              <item>
               <widget class="QPushButton" name="tagger_save_next_btn">
                <property name="text">
                 <string>Save &amp; Next →  Ctrl+↵</string>
                </property>
               </widget>
              </item>
             </layout>
            </item>

           </layout>
          </widget>

          <!-- Stack page 1: Tagging Complete -->
          <widget class="QWidget" name="tagger_complete_page">
           <layout class="QVBoxLayout" name="taggerCompleteLayout">
            <item>
             <spacer name="taggerCompleteTopSpacer">
              <property name="orientation">
               <enum>Qt::Vertical</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>20</width>
                <height>40</height>
               </size>
              </property>
             </spacer>
            </item>
            <item>
             <widget class="QLabel" name="tagger_complete_label">
              <property name="text">
               <string>Tagging Complete! All skins have been tagged.</string>
              </property>
              <property name="alignment">
               <set>Qt::AlignCenter</set>
              </property>
              <property name="font">
               <font>
                <pointsize>18</pointsize>
                <weight>75</weight>
                <bold>true</bold>
               </font>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="taggerCompleteBottomSpacer">
              <property name="orientation">
               <enum>Qt::Vertical</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>20</width>
                <height>40</height>
               </size>
              </property>
             </spacer>
            </item>
           </layout>
          </widget>

         </widget>
        </item>

       </layout>
      </widget>

     </widget>
    </item>
   </layout>
